{
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "daisyui": "^5.7.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i src/css/app.css -o static/css/output.css -w",
    "dev:js": "vite build --watch",
    "dev:server": "z8 run dev",
    "dev": "concurrently -n css,js,server -c green,blue,magenta \"npm:dev:css\" \"npm:dev:js\" \"npm:dev:server\"",
    "typecheck": "tsc --noEmit",
    "build:css": "npx @tailwindcss/cli -i src/css/app.css -o static/css/output.css",
    "build:js": "vite build",
    "build": "npm run build:css && npm run build:js",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
